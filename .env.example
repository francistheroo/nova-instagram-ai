# AI text provider (OpenAI-compatible chat completions API)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Protect NOVA action endpoints. Generate a long random secret and keep it private.
NOVA_API_KEY=

# Meta Instagram API. Use credentials issued through the official Meta authorization flow.
# Choose the correct host/version and permissions for your selected Instagram Login flow.
META_GRAPH_BASE_URL=https://graph.instagram.com
META_API_VERSION=v23.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Leave false until authorization and read-only endpoints are tested.
INSTAGRAM_AUTOMATION_ENABLED=false

# Separate OpenAI-compatible image-generation provider; text-only providers may not support this.
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# Canva Connect API credentials. OAuth and design/export routes still need implementation.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
