# AI text providers. NOVA tries them in this order and fails over on rate limits or outages.
# Gemini and Groq use OpenAI-compatible chat endpoints; legacy custom provider remains supported.
AI_PROVIDER_ORDER=gemini,groq,legacy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional additional OpenAI-compatible provider (Hugging Face usage may be billable).
HF_TOKEN=
HF_CHAT_MODEL=openai/gpt-oss-120b:fastest
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Protect NOVA action endpoints. Generate a long random secret and keep it private.
NOVA_API_KEY=

# Official Instagram Login OAuth. Register this exact HTTPS callback URI in Meta.
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=https://nova-instagram-ai.onrender.com/oauth/instagram/callback
# Request only the scopes actually needed and approved for the app.
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages
OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=

# Meta Instagram Graph API. OAuth currently uses Instagram Login.
META_GRAPH_BASE_URL=https://graph.instagram.com
META_API_VERSION=v25.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Leave false until authorization and read-only endpoints are tested.
INSTAGRAM_AUTOMATION_ENABLED=false
# Background auto-publishing is separately opt-in; requires an always-on service.
NOVA_SCHEDULER_ENABLED=false
NOVA_TIMEZONE=Asia/Kolkata
NOVA_ADMIN_USERNAME=
NOVA_ADMIN_PASSWORD=

# Separate image-generation provider. This is independent of text-provider failover; free image API quotas are not guaranteed.
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# Canva Connect API OAuth (PKCE). Register this exact HTTPS callback in Canva Developers.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=https://nova-instagram-ai.onrender.com/oauth/canva/callback
CANVA_OAUTH_SCOPES=design:content:read design:content:write design:meta:read

# Instagram Messaging webhook (keep these server-side)
META_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Leave false until Meta permissions, webhooks, and a test conversation are verified.
INSTAGRAM_AUTO_DM_REPLIES_ENABLED=false
